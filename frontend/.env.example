# URL de l'API Django, SANS slash final.
#
# En developpement c'est l'IP LOCALE de la machine qui fait tourner Django,
# jamais localhost : sur le telephone, localhost designe le telephone.
#
#   Windows : ipconfig      -> "Adresse IPv4"
#   macOS   : ipconfig getifaddr en0
#   Linux   : hostname -I
#
# Le prefixe EXPO_PUBLIC_ est obligatoire pour qu'Expo injecte la variable dans le
# bundle. Apres modification, relancer avec `npx expo start -c`.
EXPO_PUBLIC_API_URL=http://192.168.1.13:8000
