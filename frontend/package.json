{
  "name": "frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "check:classes": "storybook build -c .storybook -o .sb-check --quiet && node scripts/check-classes.mjs .sb-check",
    "storybook:index": "sb-rn-get-stories",
    "storybook:native": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start -c",
    "storybook:web": "storybook dev -p 6006 -c .storybook",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "dependencies": {
    "@expo-google-fonts/cutive-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/martian-mono": "^0.4.2",
    "@expo-google-fonts/sometype-mono": "^0.4.2",
    "@expo-google-fonts/spline-sans-mono": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "axios": "1.19.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "jwt-decode": "4.0.0",
    "nativewind": "4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@storybook/react-native": "10.4.6",
    "@storybook/react-native-web-vite": "10.4.6",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "autoprefixer": "10.5.4",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-native": "5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.4.6",
    "style-dictionary": "^5.5.0",
    "tailwindcss": "3.4.19",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2",
    "vite": "8.2.0"
  },
  "private": true
}
